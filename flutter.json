{
  "app": {
    "name": "FlutterDemoApp",
    "version": "1.0.0",
    "environment": "production"
  },
  "theme": {
    "primaryColor": "#2196F3",
    "secondaryColor": "#FF9800",
    "darkMode": false,
    "fontFamily": "Roboto"
  },
  "api": {
    "baseUrl": "https://api.example.com",
    "timeoutSeconds": 30,
    "endpoints": {
      "login": "/auth/login",
      "users": "/users",
      "products": "/products"
    }
  },
  "features": {
    "pushNotifications": true,
    "googleLogin": true,
    "offlineMode": true,
    "analytics": false
  },
  "user": {
    "defaultLanguage": "en",
    "supportedLanguages": [
      "en",
      "es",
      "fr"
    ]
  },
  "flutter": {
    "minSdkVersion": 21,
    "targetSdkVersion": 35,
    "dependencies": {
      "provider": "^6.1.2",
      "http": "^1.2.2",
      "shared_preferences": "^2.3.2"
    }
  }
}
